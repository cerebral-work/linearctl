{
  "compilerOptions": {
    // Bun compiles + runs the code; tsc is the type-checker only (`bun run
    // typecheck` → `tsc --noEmit`). No tsc emit, so no outDir/rootDir.
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Ink (ADR-0008) renders via React's automatic JSX runtime. `.tsx` files
    // import React hooks (`useInput`, `useApp`, `useState`) and emit elements
    // that tsc must type-check against `@types/react`.
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
}
