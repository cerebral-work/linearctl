{
  "compilerOptions": {
    // Bun compiles + runs the code; tsc is the type-checker only (`bun run
    // typecheck` → `tsc --noEmit`). No tsc emit, so no outDir/rootDir.
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
