# Toolchain pins for contributors (proto reads this; mirrors the maintainer's
# mise pins so local ↔ CI match). Run `proto use` to install.
#
# bun is the build + test + runtime toolchain for the TS CLI. node is pinned
# only so editor / LSP integrations resolve to the same major. moon drives
# project-scoped Rust tasks. Rust is pinned by rust-toolchain.toml.
bun = "1.3.14"
node = "24.16.0"
moon = "2.2.6"

[settings.offline]
# The estate ci-rust runner netpol allows only :443 egress (DNS via
# kube-system only), so proto's default offline probes (public DNS :53,
# http :80) read as offline and abort plugin downloads with `plugin::offline`
# even though ghcr.io:443 is reachable. Probe the :443 hosts proto needs.
custom-hosts = ["github.com:443", "ghcr.io:443"]
override-default-hosts = true
