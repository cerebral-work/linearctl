{
  "name": "linearctl",
  "version": "0.4.0",
  "private": true,
  "description": "linearctl — a headless CLI for frequently ad-hocced Linear workflows (digest, file, triage, milestone), built on @linear/sdk.",
  "type": "module",
  "bin": {
    "linearctl": "dist/linearctl"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "whoami": "bun run src/index.ts whoami",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --compile --minify --outfile dist/linearctl"
  },
  "keywords": [
    "linear",
    "cli",
    "workflow",
    "issue-tracking",
    "bun"
  ],
  "author": "Christian M. Todie <chris@todie.io>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@linear/sdk": "^86.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
