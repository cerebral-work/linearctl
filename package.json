{
  "name": "linear-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "lw — a headless CLI for frequently ad-hocced Linear workflows (digest, file, triage, milestone), built on @linear/sdk.",
  "type": "module",
  "bin": {
    "lw": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "whoami": "tsx src/index.ts whoami",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "linear",
    "cli",
    "workflow",
    "issue-tracking"
  ],
  "author": "Christian M. Todie <chris@todie.io>",
  "license": "UNLICENSED",
  "dependencies": {
    "@linear/sdk": "^86.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
